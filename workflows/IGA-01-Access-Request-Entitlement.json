    {
      "parameters": {
        "jsCode": "const sodData = $('SoD-Check').first().json;\nconst existingRoles = $input.all();\n\nconst conflictingRole = sodData.conflictingRole;\n\n// Extract role names from existing roles\nconst existingRoleNames = existingRoles.map(item => item.json.name);\n\n// Check if conflicting role already exists\nconst hasConflict = conflictingRole && existingRoleNames.includes(conflictingRole);\n\nreturn [{\n  json: {\n    username: sodData.username,\n    requestedRole: sodData.requestedRole,\n    requestedBy: sodData.requestedBy,\n    justification: sodData.justification,\n    conflictingRole: conflictingRole,\n    existingRoles: existingRoleNames,\n    hasConflict: hasConflict,\n    timestamp: sodData.timestamp\n  }\n}];"
      },
