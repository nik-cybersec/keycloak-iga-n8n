      "parameters": {
        "jsCode": "const sodData = $('SoD-Check').first().json;\nconst roleData = $('Get-Role-Id').first().json;\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    action: \"ROLE_ASSIGNED\",\n    username: sodData.username,\n    roleAssigned: roleData.name,\n    roleId: roleData.id,\n    requestedBy: sodData.requestedBy,\n    justification: sodData.justification,\n    decidedBy: \"Auto-Approved\",\n    status: \"SUCCESS\"\n  }\n}];"
      },
