    {
      "parameters": {
        "jsCode": "const input = $('Webhook').first().json.body;\nconst username = input.username;\nconst requestedRole = input.requested_role;\nconst requestedBy = input.requested_by;\nconst justification = input.justification;\n\nconst sodRules = {\n  \"manager\": \"security-analyst\",\n  \"security-analyst\": \"manager\"\n};\n\nreturn [{\n  json: {\n    username,\n    requestedRole,\n    requestedBy,\n    justification,\n    conflictingRole: sodRules[requestedRole] || null,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
